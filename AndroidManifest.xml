<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.study.timer" android:versionCode="6" android:versionName="0.6.0">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
